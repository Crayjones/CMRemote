 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1129</width><height>571</height></rect></property>
  <property name="minimumSize"><size><width>640</width><height>480</height></size></property>
  <property name="font"><font><family>Arial</family><pointsize>9</pointsize></font></property>
  <property name="windowTitle"><string>CMRemote — Qt UI preview</string></property>
  <property name="windowIcon"><iconset resource="branding.qrc"><normaloff>:/branding/cmremote-256.png</normaloff>:/branding/cmremote-256.png</iconset></property>
  <property name="dockNestingEnabled"><bool>true</bool></property>
  <property name="styleSheet"><string notr="true">QMainWindow { background: #f0f0f0; }
QMainWindow::separator { background: #dedede; width: 4px; height: 4px; }
QDockWidget { border: 1px solid #b5b5b5; color: white; }
QDockWidget::title { background: #0078d7; color: white; padding: 3px 5px; }
QToolBar { background: #f0f0f0; border: none; spacing: 1px; padding: 1px; }
QToolButton { padding: 2px; }
QMenuBar { background: #f0f0f0; padding: 1px; }
QMenuBar::item { padding: 3px 8px; }
QMenuBar::item:selected { background: #cce8ff; }
QTreeWidget, QListWidget, QPlainTextEdit { background: white; color: #202020; border: none; }
QTreeWidget::item, QListWidget::item { min-height: 19px; }
QTreeWidget::item:selected, QListWidget::item:selected { background: #0078d7; color: white; }
QLineEdit, QComboBox { background: white; color: #202020; border: 1px solid #ababab; padding: 2px; }
QTabWidget::pane { border: 1px solid #ababab; }
QTabBar::tab { background: #eeeeee; color: #202020; border: 1px solid #ababab; padding: 4px 12px; }
QTabBar::tab:selected { background: #0078d7; color: white; }
QTabWidget#sessionTabs QTabBar::tab, QTabWidget#panelSessionTabs QTabBar::tab { background: #dadada; color: #505050; }
QTabWidget#sessionTabs QTabBar::tab:selected, QTabWidget#panelSessionTabs QTabBar::tab:selected { background: #ffffff; color: #202020; border-bottom-color: #ffffff; }
QWidget#sessionSurface { background: #191919; }
QLabel#sessionMessage { color: #dddddd; background: transparent; }
QWidget#configHelp, QWidget#notificationDetails { background: #f0f0f0; }
QLabel#configHelpTitle { font-weight: bold; }
QLabel#notificationDate { color: #666666; font-style: italic; }</string></property>
