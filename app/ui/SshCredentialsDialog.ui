<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SshCredentialsDialog</class>
 <widget class="QDialog" name="SshCredentialsDialog">
  <property name="windowTitle"><string>SSH credentials</string></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QLabel" name="endpointLabel"><property name="textFormat"><enum>Qt::PlainText</enum></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item>
    <layout class="QFormLayout" name="formLayout">
     <item row="0" column="0"><widget class="QLabel" name="usernameLabel"><property name="text"><string>Username</string></property><property name="buddy"><cstring>usernameEdit</cstring></property></widget></item>
     <item row="0" column="1"><widget class="QLineEdit" name="usernameEdit"><property name="maxLength"><number>4097</number></property></widget></item>
     <item row="1" column="0"><widget class="QLabel" name="authLabel"><property name="text"><string>Authentication</string></property><property name="buddy"><cstring>authCombo</cstring></property></widget></item>
     <item row="1" column="1"><widget class="QComboBox" name="authCombo"/></item>
     <item row="2" column="0"><widget class="QLabel" name="keyPathLabel"><property name="text"><string>Key file</string></property><property name="buddy"><cstring>keyPathEdit</cstring></property></widget></item>
     <item row="2" column="1"><widget class="QLineEdit" name="keyPathEdit"><property name="maxLength"><number>4097</number></property></widget></item>
     <item row="3" column="0"><widget class="QLabel" name="authenticationLabel"><property name="text"><string>Password</string></property><property name="buddy"><cstring>authenticationEdit</cstring></property></widget></item>
     <item row="3" column="1"><widget class="QLineEdit" name="authenticationEdit"><property name="echoMode"><enum>QLineEdit::Password</enum></property><property name="maxLength"><number>4097</number></property></widget></item>
    </layout>
   </item>
   <item><widget class="QPushButton" name="chooseKeyButton"><property name="text"><string>Choose SSH key file…</string></property></widget></item>
   <item><widget class="QCheckBox" name="saveCheck"><property name="text"><string>Save to Connections</string></property><property name="toolTip"><string>Save this connection, its username and password to a connection file</string></property></widget></item>
   <item><widget class="QLabel" name="sessionLabel"><property name="text"><string>Credentials are used only for this session. No password, key contents, or passphrase are saved by this dialog.</string></property><property name="textFormat"><enum>Qt::PlainText</enum></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QLabel" name="errorLabel"><property name="textFormat"><enum>Qt::PlainText</enum></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QDialogButtonBox" name="buttonBox"><property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property></widget></item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection><sender>buttonBox</sender><signal>accepted()</signal><receiver>SshCredentialsDialog</receiver><slot>accept()</slot></connection>
  <connection><sender>buttonBox</sender><signal>rejected()</signal><receiver>SshCredentialsDialog</receiver><slot>reject()</slot></connection>
