 use crate::{PixelFormat, VncEncoding, VncError, VncVersion};
 
+/// Exact session-authorized security mechanism; never silently downgrade.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AuthenticationPolicy {
+    RequireVncAuth,
+    ExplicitNone,
+    /// Select None when the server offers it (no credential is sent), otherwise
+    /// VncAuth. The credential callback is only polled when VncAuth is selected.
+    NoneIfOffered,
+}
+
+// The upstream callback returns String. Keep that transient copy scoped and
+// wipe it best-effort on both completion and cancellation (not locked memory).
+struct Credential(Vec<u8>);
+impl Credential {
+    fn text(&self) -> &str { std::str::from_utf8(&self.0).expect("String is UTF-8") }
+}
+impl Drop for Credential {
+    fn drop(&mut self) { self.0.fill(0); }
+}
